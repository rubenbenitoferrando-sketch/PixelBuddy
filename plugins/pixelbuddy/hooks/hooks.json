    ],
    "StopFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pixelbuddy-hook.sh StopFailure",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "Notification": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pixelbuddy-hook.sh Notification",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"${CLAUDE_PLUGIN_ROOT}\"/scripts/pixelbuddy-hook.sh SessionEnd",
            "timeout": 5,
            "onFailure": "continue"
          }
        ]
      }
    ]
  }
}
